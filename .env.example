APP_ENV=development
# Local only. Railway production should use its PostgreSQL DATABASE_URL.
DATABASE_URL=sqlite+aiosqlite:///./rubika.db

USER_BOT_TOKEN=
ADMIN_BOT_TOKEN=
OWNER_BOT_TOKEN=

# Privileged access is username-only. Do not use Rubika numeric IDs here.
OWNER_USERNAME=
ADMIN_USERNAME=

# Legacy compatibility only. Not used for admin/owner authorization.
OWNER_ID=
LOG_LEVEL=INFO

# Operational List-account sessions. On Railway mount a persistent Volume at /data.
RUBIKA_SESSION_DIR=./sessions
LIST_ACCOUNT_SYNC_SECONDS=30
